{
 "__inputs": [
  {
   "name": "DS_INFLUX",
   "label": "InfluxDB (Flux)",
   "type": "datasource",
   "pluginId": "influxdb",
   "pluginName": "InfluxDB"
  }
 ],
 "title": "Avarma Kältekreis – Kalibrierung (experimentell)",
 "uid": "avarma-kk-kalibrierung",
 "tags": [
  "avarma",
  "kaeltekreis",
  "experimentell"
 ],
 "timezone": "browser",
 "graphTooltip": 1,
 "editable": true,
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Datenquelle",
    "type": "datasource",
    "query": "influxdb",
    "current": {}
   },
   {
    "name": "bucket",
    "label": "Bucket",
    "type": "textbox",
    "query": "homeassistant",
    "current": {
     "text": "homeassistant",
     "value": "homeassistant"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "Hinweis",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**Experimentelle Auswertung – keine Herstellerfreigabe.** Rohwerte links (ohne Nullauffüllung, Lücken bleiben Lücken), 5-min-Median rechts. Grün/Gelb/Rot werden hier bewusst **nicht** verwendet. Herstellersoll Überhitzung Heizen 0,5 K (P92–P96, Regelziel, kein Grenzwert). Ursache negativer Werte ist offen (Te-Auflösung 0,5 K, Ts/Te asynchron). Alle Panels teilen Zeitachse und Fadenkreuz."
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Verdichter Hz · Lüfter rpm",
   "description": "",
   "datasource": {
    "type": "influxdb",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${ds}"
     },
     "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.entity_id == \"hausinstallation_avarma_verdichterfrequenz_ist\" and r._field == \"value\")\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> map(fn: (r) => ({r with _field: \"Verdichter Hz\"}))\n  |> yield(name: \"A\")"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "influxdb",
      "uid": "${ds}"
     },
     "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.entity_id == \"hausinstallation_avarma_lufter_1_drehzahl\" and r._field == \"value\")\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> map(fn: (r) => ({r with _field: \"Lüfter rpm\"}))\n  |> yield(name: \"B\")"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "hertz",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "pointSize": 3,
      "showPoints": "never",
      "spanNulls": false,
      "lineInterpolation": "stepAfter",
      "fillOpacity": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*Verdichter.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ff8a2a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*Lüfter.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3ac8ef"
        }
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "unit",
        "value": "rotrpm"
       }
      ]
     }
    ]
   },
   "options": {
    "tooltip": {
     "mode": "multi"
    },
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
